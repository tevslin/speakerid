# ============================================================================
# speakerid (SmartTranscripts™ Generator) Local Configuration (.env.example)
# NOTE: Replace the dummy placeholder keys/tokens below with your real values!
# ============================================================================

# 1. Hugging Face Token (Required for PyAnnote Speaker Diarization)
# Accept user conditions at:
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
#   - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_DUMMY_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN

# Optional: Local folder to cache downloaded WhisperX & PyAnnote models
# SPEAKERID_MODEL_DIR=./models

# 2. Pluggable LLM Configuration (Local or Remote)
# Supported LLM_PROVIDER values:
#   - ollama    (Local Ollama server, default URL: http://localhost:11434)
#   - openai    (OpenAI API, or any local OpenAI-compatible server via LLM_BASE_URL)
#   - vllm      (Local vLLM server, default URL: http://localhost:8000/v1)
#   - lmstudio  (Local LM Studio server, default URL: http://localhost:1234/v1)
#   - llamacpp  (Local llama.cpp server, default URL: http://localhost:8080/v1)
#   - gemini    (Google Gemini API)
#   - anthropic (Anthropic Claude API)
#   - litellm   (LiteLLM universal router)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.3
# Optional custom endpoint URL (only needed if overriding the provider's default URL):
# LLM_BASE_URL=http://localhost:11434
# Optional generic override key (leave commented out if using GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY below)
# LLM_API_KEY=DUMMY_LOCAL_LLM_API_KEY_NOT_REQUIRED_FOR_OLLAMA

# 3. Remote LLM API Keys (Only needed if using a remote cloud LLM)
GEMINI_API_KEY=AIzaSyDUMMY_REPLACE_WITH_YOUR_GEMINI_API_KEY
OPENAI_API_KEY=sk-proj-DUMMY_REPLACE_WITH_YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=sk-ant-DUMMY_REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
